# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-development-key-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=scholaria_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security Settings (Only active if DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Logging
DJANGO_LOG_LEVEL=INFO

# AI / LLM
GROQ_API_KEY=your_groq_api_key_here

# RAG / Embeddings
# Set to True (or 1) to force offline mode (no huggingface.co remote calls); default is False
HF_HUB_OFFLINE=False
# Set to 0 to disable preloading embeddings and tokenizers at server startup (default is 1)
RAG_WARMUP=1

# Monitoring (optional — set to enable Sentry error tracking)
SENTRY_DSN=
